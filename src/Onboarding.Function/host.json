{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 20,
        "excludedTypes": "Exception;Trace"
      },
      "enableDependencyTracking": true
    },
    "logLevel": {
      "default": "Information",
      "Function": "Information",
      "Host": "Warning"
    }
  }
}
